# Twitch application (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Twitch user IDs (numeric), not login names
TWITCH_BOT_ID=
TWITCH_OWNER_ID=

# PostgreSQL connection string (Supabase or any Postgres instance)
# Examples:
#   postgresql://user:password@host:5432/dbname
#   postgresql+asyncpg://...  (normalized automatically)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret used by Twitch to sign EventSub webhook requests.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must stay stable across restarts.
EVENTSUB_SECRET=

# Public HTTPS origin for OAuth callbacks and EventSub webhooks
# (no trailing slash). Must match Caddy and the Twitch Developer Console
# redirect URL: {OAUTH_DOMAIN}/oauth/callback
# Ignored when running with --local.
OAUTH_DOMAIN=https://oauth.example.com

LOG_LEVEL=INFO
