# PostgreSQL (обязательно). Для Supabase — connection string из Dashboard → Database.
DATABASE_URL=postgresql://user:password@localhost:5432/twitch_bot

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Twitch Developer Console → ваше приложение
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Twitch user ID аккаунта бота (не login, а числовой ID)
TWITCH_BOT_ID=

# Twitch user ID канала владельца
TWITCH_OWNER_ID=

# Секрет для проверки webhook EventSub (произвольная строка, лучше длинная)
EVENTSUB_SECRET=

# Публичный HTTPS-домен OAuth/EventSub (без слэша в конце).
# Локально можно оставить дефолт или запускать с --local.
OAUTH_DOMAIN=https://oauth.example.com

# Префикс текстовых команд в чате
TWITCH_COMMAND_PREFIX=!
